{
  "version": 2,
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/health.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/submit.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js",
      "methods": ["GET"]
    },
    {
      "src": "/api/email/application-form/submit",
      "dest": "/api/submit.js",
      "methods": ["POST"]
    }
  ]
}
